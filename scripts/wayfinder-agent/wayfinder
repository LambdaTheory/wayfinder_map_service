def human_text(text):
    text = " ".join(text.split())
    return text if text and not text.startswith("<") else ""


def codex_session(path):
    info = {"harness": "codex", "id": None, "cwd": None, "start": None, "model": None, "effort": None, "first": ""}
    humans = 0
    with open(str(path), errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            payload = record.get("payload") or {}
            if record.get("type") == "session_meta" and not info["id"]:
                info.update(id=payload.get("id"), cwd=payload.get("cwd"), start=payload.get("timestamp"))
            elif record.get("type") == "turn_context" and not info["model"]:
                info.update(model=payload.get("model"), effort=payload.get("effort"))
            elif record.get("type") == "event_msg" and payload.get("type") == "item_completed":
                item = payload.get("item") or {}
                if item.get("type") == "UserMessage":
                    humans += 1
                    if not info["first"]:
                        content = item.get("content")
                        parts = content if isinstance(content, list) else []
                        info["first"] = human_text(" ".join(p.get("text", "") for p in parts if isinstance(p, dict)))
    return info if humans else None


def claude_session(path):
    info = {"harness": "claude", "id": path.stem, "cwd": None, "start": None, "model": None, "effort": None, "first": ""}
    humans = 0
    with open(str(path), errors="replace") as handle:
        for line in handle:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if record.get("isSidechain"):
                continue
            if record.get("type") == "user" and not record.get("isMeta"):
                content = (record.get("message") or {}).get("content")
                text = human_text(content) if isinstance(content, str) else ""
                if text:
                    humans += 1
                    info["first"] = info["first"] or text
                    info["cwd"] = info["cwd"] or record.get("cwd")
                    info["start"] = info["start"] or record.get("timestamp")
            elif record.get("type") == "assistant" and not info["model"]:
                info["model"] = (record.get("message") or {}).get("model")
    return info if humans else None


def all_sessions():
    sessions = []
    for harness in HARNESSES:
        for method in METHODS:
            state = state_dir(harness, method)
            files = state.glob("sessions/**/*.jsonl") if harness == "codex" else state.glob("projects/*/*.jsonl")
            for path in files:
                info = codex_session(path) if harness == "codex" else claude_session(path)
                if info and info["id"]:
                    info.update(method=method, path=path)
                    sessions.append(info)
    sessions.sort(key=lambda s: s["start"] or "", reverse=True)
    return sessions


def mentions(info, name):
    with open(str(info["path"]), errors="replace") as handle:
        return name in handle.read()


def cmd_sessions(args):
    sessions = all_sessions()
    if args:
        sessions = [s for s in sessions if mentions(s, args[0])]
    if not sessions:
        print("没有找到会话。")
        return
    rows = [("开始", "harness", "方法版本", "模型", "开场那句", "接着这个会话")]
    for s in sessions[:20]:
        first = s["first"]
        first = first if width(first) <= 40 else first[:20] + "……"
        rows.append((local_time(s["start"]), HARNESSES[s["harness"]]["label"], METHODS[s["method"]],
                     s["model"] or "", first, "wayfinder resume " + s["id"]))
    table(rows)


def cmd_resume(args, default_method):
    if not args:
        die("用法：wayfinder resume <会话 ID>；wayfinder sessions 列出会话。")
    options, positional, passthrough = parse(args, default_method)
    if not positional:
        die("用法：wayfinder resume <会话 ID>；wayfinder sessions 列出会话。")
    match = [s for s in all_sessions() if s["id"] == positional[0]]
    if not match:
        die("专用 Agent 的会话里没有 {}。wayfinder sessions 列出会话。".format(positional[0]))
    s = match[0]
    options["harness"], options["method"] = s["harness"], s["method"]
    spec = HARNESSES[s["harness"]]
    if "model" not in options["given"]:
        options["model"] = s["model"] or spec["model"]
    if "effort" not in options["given"]:
        options["effort"] = s["effort"] if s["effort"] in spec["efforts"] else DEFAULT_EFFORT
    launch(options, passthrough=passthrough, resume_id=s["id"], cwd=s["cwd"])


# ---------------------------------------------------------------- chatgpt, status

def stop_chatgpt():
    pid = read_pid(SVC / "chatgpt.pid")
    if pid and alive(pid):
        os.kill(pid, signal.SIGINT)
        for _ in range(80):
            if not alive(pid):
                break
            time.sleep(0.25)
        say("已关掉 ChatGPT 测试连接（pid {}）。".format(pid))


def cmd_chatgpt(_args):
    runner = CHECKOUT / "scripts/local-chatgpt-test.mjs"
    if "WAYFINDER_ATTACH_TOKEN" not in runner.read_text():
        die("{} 的 ChatGPT 测试脚本还不能接到已在跑的服务上；产品仓库的 client-credentials 改动合入后才能用。".format(CHECKOUT))
    ensure_service()
    # A service before 2.0.1 refuses the whole credentials file when it sees the toolsOnly field.
    version = probe(primary_token())[1]
    tools_only = bool(re.match(r"\d+\.\d+\.\d+$", version)) and tuple(map(int, version.split("."))) >= (2, 0, 1)
    identity = client_id("ChatGPT", "", "")
    token, sha = register_credential(identity, os.getpid(), tools_only)
    try:
        if probe(token)[0] != 200:
            die("服务还不支持按来源记录，先 wayfinder restart 换到新代码。")
        record_entry(identity, "chatgpt", "mcp", None, None, token)
        env = dict(os.environ, WAYFINDER_DATABASE_PATH=database_path(), WAYFINDER_ATTACH_TOKEN=token)
        # Ctrl-C reaches the runner through the terminal; it stops the relay and tunnel, then this cleans up.
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        child = subprocess.Popen([node_bin(), str(runner)], cwd=str(CHECKOUT), env=env,
                                 preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL))
        write_private(SVC / "chatgpt.pid", "{}\n".format(child.pid))
        code = child.wait()
    finally:
        release_credential(sha)
        try:
            (SVC / "chatgpt.pid").unlink()
        except OSError:
            pass
    sys.exit(code)


