def main():
    default_method = "matt" if Path(sys.argv[0]).name == "wayfinder-matt" else "mcp"
    args = sys.argv[1:]
    head = args[0] if args else ""
    if head in REFUSED:
        die(REFUSED[head])
    if head in ("serve", "stop", "restart", "chatgpt", "desk") and default_method == "matt":
        die("对照版不连 Wayfinder 服务；服务用 wayfinder {} 管理。".format(head))
    if head == "serve":
        ensure_service()
    elif head == "stop":
        stop_service()
    elif head == "restart":
        stop_service()
        ensure_service()
    elif head == "status":
        cmd_status(args[1:])
    elif head == "desk":
        cmd_desk(args[1:])
    elif head == "maps":
        cmd_maps(args[1:])
    elif head == "sessions":
        cmd_sessions(args[1:])
    elif head == "resume":
        cmd_resume(args[1:], default_method)
    elif head == "chatgpt":
        cmd_chatgpt(args[1:])
    elif head in ("help", "-h", "--help"):
        cmd_help(args[1:])
    else:
        options, positional, passthrough = parse(args, default_method)
        if len(positional) > 1 or (positional and not ID_PATTERN.match(positional[0])):
            die("只认一个地图 ID；要原样交给 harness 的参数放在 -- 后面。wayfinder help 看用法。")
        prompt = "继续 Wayfinder 地图 {}".format(positional[0]) if positional else None
        launch(options, prompt=prompt, passthrough=passthrough)


if __name__ == "__main__":
    main()
