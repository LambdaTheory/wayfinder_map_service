def cmd_desk(args):
    if len(args) != 1 or not ID_PATTERN.fullmatch(args[0]):
        die("用法：wayfinder desk <地图 ID>")
    if sys.platform != "darwin":
        die("答题入口目前只支持 macOS；其他平台尚无可安全传递钥匙的浏览器入口。")
    ensure_service(quiet=True)
    # Read only after the service is ready: every restart replaces this capability.
    # Do not print the URL or pass it through the harness/launch metadata.
    try:
        parent = SVC.lstat()
        if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != os.getuid() or parent.st_mode & 0o077:
            raise ValueError("private directory required")
        fd = os.open(str(SVC / "answer-desk-key"), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd) as handle:
            info = os.fstat(handle.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                raise ValueError("private key required")
            key = handle.read(128)
        if not re.fullmatch(r"[A-Za-z0-9_-]{43}", key):
            raise ValueError("invalid key")
        view = get_json("/api/maps/{}/view".format(args[0]))
        if not isinstance(view, dict) or "desk" not in view:
            raise ValueError("desk disabled")
    except (OSError, ValueError):
        die("答题台未启用或钥匙不可用；当前版本默认关闭，启用 WAYFINDER_ANSWER_DESK_ENABLED=true 后重启服务。")
    url = "http://127.0.0.1:{}/maps/{}#key={}".format(PORT, args[0], key)
    try:
        # Generic webbrowser controllers (including BROWSER) put the URL in argv.
        # macOS opens the default browser through an Apple event instead. Only the
        # pipe contains the URL; never use -e, shell interpolation or an env var.
        opened = subprocess.run(["/usr/bin/osascript", "-"],
                                input='open location "{}"\n'.format(url), text=True,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                env={"PATH": "/usr/bin:/bin"}, timeout=30).returncode == 0
    except Exception:
        die("浏览器未打开答题台；请检查默认浏览器后重试。")
    if not opened:
        die("浏览器未打开答题台；请检查默认浏览器后重试。")
    say("✓ 已打开答题台 {}。刷新页面后请再运行此命令。".format(args[0]))


