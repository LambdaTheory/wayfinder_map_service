{
  "name": "wayfinder-map-core",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.3.0"
  },
  "scripts": {
    "workflow:build": "node scripts/build-workflow.mjs",
    "build": "npm run --silent workflow:build && tsc -p tsconfig.build.json",
    "backup": "npm run --silent build && node dist/sqlite-backup.js",
    "serv": "npm run --silent chatgpt:test",
    "chatgpt:test": "npm run --silent build && node --env-file-if-exists=.env.local scripts/local-chatgpt-test.mjs",
    "start": "npm run --silent build && node dist/mcp-start.js",
    "typecheck": "npm run --silent workflow:build && tsc --noEmit",
    "test": "npm run --silent workflow:build && vitest run"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "ajv": "8.20.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
